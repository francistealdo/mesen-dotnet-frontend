<Window x:Class="MesenDotNetFrontend.Wpf.Settings.ControlsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controls"
        Width="360"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="NES Controller"
            FontSize="18"
            FontWeight="SemiBold"
            Margin="0,0,0,20"/>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Up" VerticalAlignment="Center"/>
            <Button
                x:Name="UpButton"
                Grid.Row="0"
                Grid.Column="1"
                Tag="Up"
                Click="KeyButton_Click"/>

            <TextBlock Grid.Row="1" Text="Down" VerticalAlignment="Center"/>
            <Button
                x:Name="DownButton"
                Grid.Row="1"
                Grid.Column="1"
                Tag="Down"
                Click="KeyButton_Click"/>

            <TextBlock Grid.Row="2" Text="Left" VerticalAlignment="Center"/>
            <Button
                x:Name="LeftButton"
                Grid.Row="2"
                Grid.Column="1"
                Tag="Left"
                Click="KeyButton_Click"/>

            <TextBlock Grid.Row="3" Text="Right" VerticalAlignment="Center"/>
            <Button
                x:Name="RightButton"
                Grid.Row="3"
                Grid.Column="1"
                Tag="Right"
                Click="KeyButton_Click"/>

            <TextBlock Grid.Row="4" Text="A" VerticalAlignment="Center"/>
            <Button
                x:Name="AButton"
                Grid.Row="4"
                Grid.Column="1"
                Tag="A"
                Click="KeyButton_Click"/>

            <TextBlock Grid.Row="5" Text="B" VerticalAlignment="Center"/>
            <Button
                x:Name="BButton"
                Grid.Row="5"
                Grid.Column="1"
                Tag="B"
                Click="KeyButton_Click"/>

            <TextBlock Grid.Row="6" Text="Start" VerticalAlignment="Center"/>
            <Button
                x:Name="StartButton"
                Grid.Row="6"
                Grid.Column="1"
                Tag="Start"
                Click="KeyButton_Click"/>

            <TextBlock Grid.Row="7" Text="Select" VerticalAlignment="Center"/>
            <Button
                x:Name="SelectButton"
                Grid.Row="7"
                Grid.Column="1"
                Tag="Select"
                Click="KeyButton_Click"/>

            <TextBlock Grid.Row="8" Text="Fast Forward" VerticalAlignment="Center"/>

            <Button
                x:Name="FastForwardButton"
                Grid.Row="8"
                Grid.Column="1"
                Tag="FastForward"
                Click="KeyButton_Click"/>

        </Grid>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0">

            <Button
                Content="Save"
                Width="80"
                Margin="0,0,8,0"
                Click="Save_Click"/>

            <Button
                Content="Cancel"
                Width="80"
                Click="Cancel_Click"/>

        </StackPanel>

    </Grid>
</Window>