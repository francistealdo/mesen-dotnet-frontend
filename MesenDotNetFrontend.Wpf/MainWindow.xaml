<Window x:Class="MesenDotNetFrontend.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mesen .NET Frontend" Height="600" Width="900">
    <Grid>
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem
                        Header="_Open ROM..."
                        Click="OpenRom_Click" />
                    <Separator />
                    <MenuItem Header="E_xit"
                        Click="Exit_Click"/>
                </MenuItem>

                <MenuItem Header="_Emulation">
                    <MenuItem
                        x:Name="PauseResumeMenuItem"
                        Header="_Pause"
                        Click="PauseResume_Click" />
                    <MenuItem Header="_Reset" />
                </MenuItem>

                <MenuItem Header="_Help" />
            </Menu>

            <Border
    x:Name="RendererContainer"
    Background="Black"
    SizeChanged="RendererContainer_SizeChanged">

                <Grid>
                    <Image
            x:Name="EmulatorScreen"
            Stretch="Uniform"
            RenderOptions.BitmapScalingMode="NearestNeighbor" />

                    <TextBlock
            x:Name="NoRomText"
            Text="No ROM loaded"
            Foreground="White"
            FontSize="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
                </Grid>

            </Border>
        </DockPanel>
    </Grid>
</Window>
