<Window x:Class="MesenDotNetFrontend.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mesen .NET Frontend" Height="600" Width="900">
    <Grid>
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem
                        Header="_Open ROM..."
                        Click="OpenRom_Click" />
                    <MenuItem
                        Header="_Close ROM"
                        Click="CloseRom_Click" />
                    <Separator />
                    <MenuItem Header="E_xit"
                        Click="Exit_Click"/>
                </MenuItem>

                <MenuItem Header="_Emulation">
                    <MenuItem
                        x:Name="PauseResumeMenuItem"
                        Header="_Pause"
                        Click="PauseResume_Click" />    
                    <MenuItem Header="_Reset" Click="Reset_Click" />
                </MenuItem>

                <MenuItem Header="_Settings">
                    <MenuItem
                    Header="_Controls..."
                    Click="ControlsSettings_Click" />
                </MenuItem>

                <MenuItem Header="_Help" />
            </Menu>

            <Border
                x:Name="RendererContainer"
                Background="Black"
                SizeChanged="RendererContainer_SizeChanged">

                <Grid>
                    <Image
                        x:Name="EmulatorScreen"
                        Stretch="Uniform"
                        RenderOptions.BitmapScalingMode="NearestNeighbor" />

                    <Border
                        x:Name="NoRomContent"
                        Background="Black"
                        Panel.ZIndex="10">

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <Image
                                Source="pack://application:,,,/Resources/messen-dotnet-frontend.png"
                                Width="220"
                                Stretch="Uniform"
                                HorizontalAlignment="Center" />

                            <TextBlock
                                Text="No ROM loaded"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,0"
                                Opacity="0.7" />

                        </StackPanel>

                    </Border>
                </Grid>

            </Border>
        </DockPanel>
    </Grid>
</Window>
