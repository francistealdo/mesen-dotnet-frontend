<Window x:Class="MesenDotNetFrontend.Wpf.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="460"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Top">

                <Image
                    Source="pack://application:,,,/Resources/mesen-dotnet-frontend.png"
                    Width="120"
                    Height="120"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12" />

                <TextBlock
                    Text="Mesen .NET Frontend"
                    FontSize="22"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,4" />

                <TextBlock
                    x:Name="VersionText"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16"
                    Opacity="0.7" />

                <TextBlock
                    Text="A custom .NET WPF frontend for the Mesen emulator core."
                    Width="340"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,18"
                    Opacity="0.8" />

                <TextBlock
                    Text="Developed by Francis Tealdo"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,4" />

                <TextBlock
                    Text="Software Engineer"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,18"
                    Opacity="0.65" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Margin="0,6,0,18">

                    <Hyperlink
                        NavigateUri="https://github.com/francistealdo/mesen-dotnet-frontend"
                        RequestNavigate="GitHubLink_RequestNavigate">
                        View project on GitHub
                    </Hyperlink>

                </TextBlock>

                <TextBlock
                    Text="Unofficial project. Not affiliated with or endorsed by the Mesen project."
                    Width="340"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"
                    Opacity="0.55" />

                <Button
                    Content="OK"
                    Width="90"
                    Height="32"
                    HorizontalAlignment="Center"
                    IsDefault="True"
                    Click="Ok_Click" />

            </StackPanel>

        </ScrollViewer>

    </Grid>
</Window>