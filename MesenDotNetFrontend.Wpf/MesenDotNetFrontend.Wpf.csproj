<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Resources\mesen-dotnet-frontend.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\MesenDotNetFrontend.Core\MesenDotNetFrontend.Core.csproj" />
		<ProjectReference Include="..\MesenDotNetFrontend.Infrastructure\MesenDotNetFrontend.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\mesen-dotnet-frontend.png" />
		<Resource Include="Resources\mesen-dotnet-frontend.ico" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Native\" />
		<None Include="Native\MesenCore.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>MesenCore.dll</TargetPath>
		</None>
	</ItemGroup>

</Project>
