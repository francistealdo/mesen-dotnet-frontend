<Window x:Class="MesenDotNetFrontend.Wpf.SaveStates.SaveStateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save State"
        Width="420"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Save State"
            FontSize="22"
            FontWeight="SemiBold"
            Margin="0,0,0,16" />

        <Border
            Grid.Row="1"
            Background="Black"
            CornerRadius="4"
            Padding="4"
            HorizontalAlignment="Center">

            <Image
                x:Name="PreviewImage"
                Width="256"
                Height="240"
                Stretch="Uniform" />

        </Border>

        <StackPanel
            Grid.Row="2"
            Margin="0,18,0,0">

            <TextBlock
                Text="Name"
                Margin="0,0,0,6" />

            <TextBox
                x:Name="NameTextBox"
                Height="30"
                VerticalContentAlignment="Center" />

        </StackPanel>

        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0">

            <Button
                Content="Cancel"
                Width="90"
                Height="32"
                Margin="0,0,10,0"
                IsCancel="True" />

            <Button
                Content="Save"
                Width="90"
                Height="32"
                IsDefault="True"
                Click="Save_Click" />

        </StackPanel>

    </Grid>
</Window>