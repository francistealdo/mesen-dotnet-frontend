<Window x:Class="MesenDotNetFrontend.Wpf.SaveStates.LoadGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load Game"
        Width="800"
        Height="520"
        MinWidth="700"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Load Game"
            FontSize="22"
            FontWeight="SemiBold"
            Margin="0,0,0,16" />

        <ListView
            x:Name="SaveStatesList"
            Grid.Row="1"
            SelectionMode="Single"
            MouseDoubleClick="SaveStatesList_MouseDoubleClick">

            <ListView.View>

                <GridView>

                    <GridViewColumn
                        Header="Screenshot"
                        Width="150">

                        <GridViewColumn.CellTemplate>

                            <DataTemplate>

                                <Border
                                    Background="Black"
                                    Padding="2"
                                    Margin="2">

                                    <Image
                                        Width="128"
                                        Height="120"
                                        Stretch="Uniform"
                                        Source="{Binding Screenshot}" />

                                </Border>

                            </DataTemplate>

                        </GridViewColumn.CellTemplate>

                    </GridViewColumn>

                    <GridViewColumn
                        Header="Date"
                        Width="150"
                        DisplayMemberBinding="{Binding CreatedAtDisplay}" />

                    <GridViewColumn
                        Header="Name"
                        Width="200"
                        DisplayMemberBinding="{Binding Name}" />

                    <GridViewColumn
                        Header="ROM"
                        Width="180"
                        DisplayMemberBinding="{Binding RomName}" />

                </GridView>

            </ListView.View>

        </ListView>

        <Grid
            Grid.Row="2"
            Margin="0,16,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Content="Delete"
                Width="90"
                Height="32"
                HorizontalAlignment="Left"
                Click="Delete_Click" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal">

                <Button
                    Content="Cancel"
                    Width="90"
                    Height="32"
                    Margin="0,0,10,0"
                    IsCancel="True" />

                <Button
                    Content="Load"
                    Width="90"
                    Height="32"
                    IsDefault="True"
                    Click="Load_Click" />

            </StackPanel>

        </Grid>

    </Grid>

</Window>